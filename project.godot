; Engine configuration file.
; G.I KO KO - MYANMAR OPEN WORLD 3D
; Godot 3.5.2 Stable - GLES2 - Android 10 - ARMv7 (armeabi-v7a)
; Optimized for Redmi 9A class devices.

config_version=3

[application]

config/name="G.I KO KO Myanmar Open World 3D"
config/description="Myanmar open world farming, survival and life simulation. Powered by I KO KO."
run/main_scene="res://scenes/splash.tscn"
config/icon="res://icon.svg"
config/version="1.0.0"

[autoload]

Events="*res://scripts/autoload/events.gd"
ItemDB="*res://scripts/autoload/item_db.gd"
TerrainGen="*res://scripts/autoload/terrain_gen.gd"
Props="*res://scripts/autoload/props.gd"
AudioSynth="*res://scripts/autoload/audio_synth.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveMgr="*res://scripts/autoload/save_manager.gd"
Missions="*res://scripts/autoload/mission_manager.gd"

[display]

window/size/width=1280
window/size/height=720
window/stretch/mode="2d"
window/stretch/aspect="keep"
window/handheld/orientation="landscape"
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_fps=30

[rendering]

quality/driver/driver_name="GLES2"
quality/shadows/filter_quality=0
vram_compression/import_etc=true
